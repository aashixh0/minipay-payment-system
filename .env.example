# ──────────────────────────────────────────────────────────────────────────────
# MiniPay Environment Variables — copy to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://minipay:minipay@localhost:5432/minipay

# ── API ───────────────────────────────────────────────────────────────────────
# Change this to a strong random secret in production.
API_KEY=dev-key-change-me
API_BASE_URL=http://localhost:8000

# ── MQTT broker ───────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Ingestion service ─────────────────────────────────────────────────────────
INGESTION_WORKERS=4
INGESTION_QUEUE_SIZE=1000

# ── Webhook worker ────────────────────────────────────────────────────────────
WEBHOOK_WORKERS=8
WEBHOOK_POLL_INTERVAL_S=1
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_S=5

# ── Acquirer ──────────────────────────────────────────────────────────────────
ACQUIRER=mock
# Inject random failures for demos (0.0 = never, 1.0 = always)
MOCK_ACQUIRER_FAILURE_RATE=0.0

# ── POS Simulator ─────────────────────────────────────────────────────────────
SIM_TERMINALS=5
SIM_RATE_PER_TERMINAL=1.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
